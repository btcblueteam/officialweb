# ================================================================
# Bitcoin Blue Frontend — Environment Variables Template
# ⚠️ Copy this file to .env.local and fill in your actual values
# ❌ NEVER commit .env.local to GitHub
# ================================================================

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── BSC RPC ──
BSC_RPC_URL=https://rpc.ankr.com/bsc

# ── Admin Authentication ──
ADMIN_PASSWORD=change_this_to_a_strong_password
JWT_SECRET=generate_a_long_random_string_here

# ── Twitter / X API ──
TWITTER_BEARER_TOKEN=your_bearer_token
TWITTER_CLIENT_ID=your_client_id
TWITTER_CLIENT_SECRET=your_client_secret

# ── NextAuth ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_secret

# ── SMTP Email ──
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=465
SMTP_USER=your_email@domain.com
SMTP_PASS=your_email_password

# ── ECDSA Smart Contract Signer ──
SIGNER_PRIVATE_KEY=your_signer_private_key

# ── Smart Contract Addresses (public, safe to share) ──
NEXT_PUBLIC_TOKEN_ADDRESS=0x...
NEXT_PUBLIC_PRESALE_ADDRESS=0x...
NEXT_PUBLIC_AIRDROP_ADDRESS=0x...
